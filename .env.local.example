# --- Spotify (host device only authenticates) ---
# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI in the app settings: http://127.0.0.1:3000/callback
# (Spotify no longer allows http://localhost — it must be the 127.0.0.1 loopback.)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# --- Supabase (realtime game sync) ---
# Create a project at https://supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
